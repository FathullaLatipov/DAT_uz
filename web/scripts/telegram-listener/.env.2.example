# Template for a SECOND instance (a second Telegram account, running in a second terminal).
# Copy to .env.2, fill in the credentials, then before running in that terminal:
#   $env:ENV_FILE = ".env.2"     (PowerShell; `export ENV_FILE=.env.2` on macOS/Linux)
#   python listener.py
# When it asks for a phone number, use a DIFFERENT account than instance A's — reusing the same
# number just reconnects to the same (possibly flood-waited) account under a new name.

# Can be the same api_id/api_hash as instance A's .env, or a fresh pair from
# https://my.telegram.org — either works; api_id is an "app identity", not an account identity.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Must differ from instance A's TELEGRAM_SESSION_NAME, or you'll overwrite its session file.
TELEGRAM_SESSION_NAME=karvon_listener_2

# Same Karvon server and secret as instance A.
KARVON_URL=http://localhost:3000
KARVON_INGEST_SECRET=

# Instance A should be SHARD=0/2 and this one SHARD=1/2, so the two split the group list instead
# of both reading all of it. For 3+ instances use "0/3", "1/3", "2/3", etc.
SHARD=1/2

# Must differ from instance A's, or the two processes will corrupt each other's progress file.
STATE_FILE=state_2.json
LOG_FILE=listener_2.log
