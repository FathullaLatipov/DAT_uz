# Get these at https://my.telegram.org -> API development tools, using YOUR clean account.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Session file name (without .session) — created on first login, then reused.
TELEGRAM_SESSION_NAME=karvon_listener

# Karvon server to send parsed ads to, and the shared secret from its web/.env
# (TELEGRAM_INGEST_SECRET). Must match exactly.
KARVON_URL=http://localhost:3000
KARVON_INGEST_SECRET=

# Optional overrides — defaults in listener.py are already reasonable.
# PER_GROUP_DELAY_S=2.0
# POLL_INTERVAL_MIN=5
# BACKFILL_MESSAGES=30
# MAX_MESSAGES_PER_POLL=200
# GROUPS_CSV=../../data/telegram_groups.csv
