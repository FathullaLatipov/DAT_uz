# Template for a THIRD instance (yet another Telegram account, a third terminal). Copy to
# .env.3, fill in the credentials, then before running in that terminal:
#   $env:ENV_FILE = ".env.3"     (PowerShell; `export ENV_FILE=.env.3` on macOS/Linux)
#   python listener.py
# When it asks for a phone number, use an account that ISN'T instance A's or instance B's.
#
# To add a 4th+ instance later: copy this file again, bump SHARD's denominator in EVERY
# instance's .env* to the new total instance count (e.g. 4), and give each one its own
# numerator (0, 1, 2, 3, ...), its own STATE_FILE, LOG_FILE and TELEGRAM_SESSION_NAME. All
# instances must share the same denominator at once or the split won't be clean.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

TELEGRAM_SESSION_NAME=karvon_listener_3

KARVON_URL=http://localhost:3000
KARVON_INGEST_SECRET=

SHARD=2/3

STATE_FILE=state_3.json
LOG_FILE=listener_3.log
