# PostgreSQL connection string (local dev and Vercel both use the same Postgres — e.g. a
# free Neon project; SQLite doesn't work on Vercel's read-only serverless filesystem).
# DATABASE_URL is the pooled connection (what the app queries at runtime); DIRECT_URL is the
# non-pooled one (what `prisma migrate` needs). Neon's "Connect" dialog gives you both — toggle
# "Connection pooling" off/on, or just drop "-pooler" from the host for the direct one.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
# ≥32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Set to 1 once this app is served over HTTPS (always true on Vercel), so the session
# cookie is marked Secure. Leave unset for local HTTP (http://localhost) — a Secure cookie
# over plain HTTP can be dropped by the browser and cause sign-in to never stick.
# COOKIE_SECURE=1   (set this to 1 in Vercel's project env vars)
# Optional: enables the LLM parser/summaries in the AI dispatcher. Without it a rule-based parser is used.
# ANTHROPIC_API_KEY=""

# DIIP.UZ public feed (only with the operators permission). Contact goes in the User-Agent.
DIIP_SYNC=off
DIIP_MAX_PAGES=5
DIIP_CONTACT=you@example.com
# Hide demo listings on public pages once real data is flowing:
# HIDE_DEMO=1

# Secret the local Telegram listener script (scripts/telegram-listener/) authenticates with.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_INGEST_SECRET=""

# ── Background jobs (source sync, expiry, saved-search alerts, FX refresh, health check) ──
# JOBS_ENABLED=1 starts the scheduler inside the server process (use it on the Docker host).
# Leave it unset on Vercel and call POST /api/jobs/run from an external cron instead.
JOBS_ENABLED=
# Shared secret for POST /api/jobs/run (header x-ingest-secret). Required when JOBS_ENABLED=1.
JOBS_SECRET=
# Where operators get alerts (source down, Telegram listener silent, FX stale...). Needs
# TELEGRAM_BOT_TOKEN; the chat id is yours or a group's. In-app notifications to admins always happen.
TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ── Per-user Telegram alerts (saved searches → the user's own Telegram) ──
# Create a bot with @BotFather and put its token in TELEGRAM_BOT_TOKEN (same variable as the operator
# alerts above — one bot can do both). APP_URL is the public https address of this site; the bot's
# webhook is registered at APP_URL/api/telegram/webhook automatically the first time a user connects.
# APP_URL=https://karvon.example.com
# Optional: skip the getMe lookup of the bot's @username.
# TELEGRAM_BOT_USERNAME=

# ── E-mail (copies of important notifications: a load was taken, delivered, a company was verified, saved-search alerts) ──
# Any SMTP account works: a transactional provider (Brevo, Mailgun, SendGrid…) or Gmail with an app password, e.g.
#   SMTP_URL=smtps://user%40gmail.com:app-password@smtp.gmail.com:465
# Without SMTP_URL nothing is sent (in-app and Telegram notifications are unaffected). People can switch it off in Settings.
# For development, SMTP_URL=file:./outbox.jsonl writes each message to that file instead of sending it.
# SMTP_URL=
# EMAIL_FROM="Karvon <no-reply@your-domain>"

