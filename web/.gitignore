# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local SQLite dev database (never ship real/dev data in git; prod uses DATABASE_URL to Postgres)
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# copied from node_modules at build time
/public/maplibre/

# Telegram listener: Telethon session (acts as a live login!), local state and logs
scripts/telegram-listener/*.session
scripts/telegram-listener/*.session-journal
scripts/telegram-listener/state*.json
scripts/telegram-listener/listener*.log
scripts/telegram-listener/run.*.log
scripts/telegram-listener/.venv/
scripts/telegram-listener/__pycache__/
!scripts/telegram-listener/.env.example
!scripts/telegram-listener/.env.2.example
!scripts/telegram-listener/.env.3.example
